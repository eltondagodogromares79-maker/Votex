# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENV=development

FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────────
# Runtime role: create a non-owner INHERIT login. Migration 053 grants it votex_app.
DATABASE_URL=postgres://votex_runtime:change-me@localhost:5432/votex
# Migration role: use the schema owner with CREATEROLE permission.
MIGRATOR_DATABASE_URL=postgres://postgres:change-me@localhost:5432/votex
DATABASE_RUNTIME_ROLE=votex_runtime

DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# ──────────────────────────────────────────────────────────────────────────────
# JWT / Session
# ──────────────────────────────────────────────────────────────────────────────
# SECURITY: Use a long (≥64 char), cryptographically random value in production.
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ISSUER=votex-backend
JWT_AUDIENCE=votex-frontend
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ──────────────────────────────────────────────────────────────────────────────
# Cookie security
# ──────────────────────────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
# Leave blank to omit the Domain attribute (recommended for localhost).
COOKIE_DOMAIN=
# Strict | Lax | None  (use Strict unless you need cross-site cookies)
COOKIE_SAME_SITE=Strict

# ──────────────────────────────────────────────────────────────────────────────
# Google OAuth
# ──────────────────────────────────────────────────────────────────────────────
# Your OAuth 2.0 Client ID from https://console.cloud.google.com/
# Authorized JavaScript origins must include your frontend origin.
# No client secret is required — the backend only verifies Google ID tokens.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Defaults applied when a first-time Google user does not supply these values.
GOOGLE_DEFAULT_COUNTRY_CODE=PH
GOOGLE_DEFAULT_TIMEZONE=Asia/Manila

# ──────────────────────────────────────────────────────────────────────────────
# PayMongo (audience votes and optional automated organization subscriptions)
# ──────────────────────────────────────────────────────────────────────────────
# Keys from https://dashboard.paymongo.com/developers
# Subscription checkout mode: MANUAL keeps reference/proof + admin review;
# AUTOMATED redirects organization owners to PayMongo hosted checkout.
# Audience vote checkout continues to use PayMongo in either subscription mode.
SUBSCRIPTION_PAYMENT_MODE=MANUAL
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
# Webhook secret from https://dashboard.paymongo.com/webhooks
PAYMONGO_WEBHOOK_SECRET_KEY=whsec_your_webhook_secret_here
# Public HTTPS frontend return destinations (use your frontend tunnel while local).
# Payment is only confirmed by the signed backend webhook.
PAYMONGO_SUCCESS_URL=https://your-frontend-tunnel.example/org_owner/billing/plans?checkout=success
PAYMONGO_CANCEL_URL=https://your-frontend-tunnel.example/org_owner/billing/plans?checkout=cancelled
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,paymaya,grab_pay,qrph,card

# ──────────────────────────────────────────────────────────────────────────────
# Email / SMTP
# ──────────────────────────────────────────────────────────────────────────────
# Leave SMTP_USERNAME empty to run in no-op/dev mode: codes are logged to
# the console instead of being emailed. Useful for local development.
#
# For a free dev sandbox try Mailtrap: https://mailtrap.io/
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
EMAIL_FROM_ADDRESS=no-reply@votex.app
EMAIL_FROM_NAME=Votex
# How long the 6-digit code is valid (minutes). Default: 10.
EMAIL_CODE_EXPIRY_MINUTES=10


# No Authorization header → 401
# Malformed Bearer token → 401
# Invalid JWT → 401
# Valid JWT → 200
# Returned user_id matches the logged-in user
# Returned session_id matches the JWT's sid
